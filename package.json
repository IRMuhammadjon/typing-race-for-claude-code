{
  "name": "typing-race-for-claude-code",
  "displayName": "Zerikma for Claude Code",
  "description": "%description%",
  "version": "0.6.0",
  "publisher": "MuhammadjonRahmatullayev",
  "author": {
    "name": "Muhammadjon Rahmatullayev",
    "url": "https://www.linkedin.com/in/muhammadjon-rahmatullayev-b9356a321/"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/IRMuhammadjon/typing-race-for-claude-code.git"
  },
  "bugs": {
    "url": "https://github.com/IRMuhammadjon/typing-race-for-claude-code/issues"
  },
  "homepage": "https://github.com/IRMuhammadjon/typing-race-for-claude-code#readme",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#323437",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other",
    "Education"
  ],
  "keywords": [
    "claude",
    "claude code",
    "typing",
    "typing test",
    "monkeytype",
    "2048",
    "breakout",
    "arcade",
    "game",
    "productivity",
    "ai"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "typingRace.open",
        "title": "%command.open%",
        "category": "Zerikma"
      },
      {
        "command": "typingRace.installHooks",
        "title": "%command.installHooks%",
        "category": "Zerikma"
      },
      {
        "command": "typingRace.uninstallHooks",
        "title": "%command.uninstallHooks%",
        "category": "Zerikma"
      }
    ],
    "configuration": {
      "title": "Zerikma",
      "properties": {
        "typingRace.autoOpen": {
          "type": "boolean",
          "default": true,
          "description": "%config.autoOpen%"
        }
      }
    }
  }
}
